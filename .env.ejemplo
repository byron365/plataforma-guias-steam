# Configuración de la plataforma de guías
# Copia este archivo como .env (el servidor lo hace solo la primera vez) y cambia los valores.

# Contraseña para entrar al panel del docente
DOCENTE_CLAVE=cambia-esta-clave

# Puerto donde escucha el servidor (la dirección será http://TU-IP:PUERTO)
PUERTO=3000

# Carpeta de las listas de materiales (Word o PDF) que se ofrecen en Descargas.
# Si no se escribe, se usa la carpeta "Listas de materiales" que está junto a Plataforma-guias.
# LISTAS_DIR=C:\Users\docente\Documents\Listas de materiales

# Carpeta con los STL de cada proyecto ("<proyecto> - STL para imprimir") que se ofrecen en Descargas.
# Si no se escribe, se usa la carpeta "STL" que está junto a Plataforma-guias.
# STL_DIR=C:\Users\docente\Documents\STL

# Navegador que crea los PDF de las guías. Si no se escribe, se usa Microsoft Edge o Google Chrome.
# NAVEGADOR_PDF=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
